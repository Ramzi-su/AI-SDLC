# ===================================
# AI-SDLC Environment Configuration
# ===================================

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=codellama:7b

# Cloud LLM (Optional): the app lists your account's available models automatically.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# vLLM or any OpenAI-compatible server (Optional).
# With podman-compose.vllm.yml:  VLLM_BASE_URL=http://vllm:8000/v1
# VLLM_BASE_URL=
# VLLM_API_KEY=
# Settings of the bundled vLLM service (podman-compose.vllm.yml):
# VLLM_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct-AWQ
# VLLM_GPU_MEMORY_UTILIZATION=0.85
# VLLM_MAX_MODEL_LEN=8192
# VLLM_DTYPE=auto
# HF_TOKEN=

# Accounts
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# Set to true when served over HTTPS
COOKIE_SECURE=false
# Secret that signs session JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=
# Reverse proxy addresses (IPs or CIDR ranges, comma-separated), e.g. 172.18.0.0/16 or 10.0.0.5.
# Only set this if the API is behind a proxy; X-Forwarded-For is trusted only from these addresses.
TRUSTED_PROXIES=
# Sign-up attempts allowed per IP address per hour. Raise it if many users share one IP (e.g. a school).
REGISTER_LIMIT_PER_HOUR=10
# "Forgot password" requests allowed per IP address per hour.
FORGOT_PASSWORD_LIMIT_PER_HOUR=10

# Optional social sign-in (buttons appear only when both values are set).
# Redirect URIs to register with the provider:
#   Google: http://localhost:8000/api/auth/oauth/google/callback
#   GitHub: http://localhost:8000/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional outgoing email (verification and password reset).
# Without SMTP_HOST, emails are printed to the core-api log instead (handy for local development).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=AI-SDLC <no-reply@example.com>
# SMTP_SECURITY=starttls   # starttls (587), ssl (465) or none
